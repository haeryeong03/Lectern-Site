{
  "rules": {
    ".read": false,
    ".write": false,
    "users": {
      ".read": "(auth != null && (auth.uid === 'KMQiVU56l0ZABbXwUlRN04vSnQG2' || root.child('users/'+auth.uid).exists()))",
      "$uid": {
        ".write": "(auth != null && (auth.uid === 'KMQiVU56l0ZABbXwUlRN04vSnQG2' || root.child('users/'+auth.uid+'/main').val() === true)) && ($uid !== 'KMQiVU56l0ZABbXwUlRN04vSnQG2' || auth.uid === 'KMQiVU56l0ZABbXwUlRN04vSnQG2')",
        ".validate": "newData.hasChildren(['loginId','role']) && newData.child('role').val().matches(/^(PL|NPC|GM|SPEC)$/)",
        "main": {
          ".validate": "newData.isBoolean() && (auth.uid === 'KMQiVU56l0ZABbXwUlRN04vSnQG2' || newData.val() === false)"
        },
        "loginId": {
          ".validate": "newData.isString() && newData.val().matches(/^[a-z0-9_.-]{2,20}$/)"
        }
      }
    },
    "characters": {
      ".read": "(auth != null && (auth.uid === 'KMQiVU56l0ZABbXwUlRN04vSnQG2' || root.child('users/'+auth.uid).exists()))",
      ".write": "(auth != null && (auth.uid === 'KMQiVU56l0ZABbXwUlRN04vSnQG2' || root.child('users/'+auth.uid+'/main').val() === true))"
    },
    "settings": {
      ".read": "(auth != null && (auth.uid === 'KMQiVU56l0ZABbXwUlRN04vSnQG2' || root.child('users/'+auth.uid).exists()))",
      "gameDate": {
